 "news": [
  {
   "headline": "Evropská komise navrhla aktualizovat pravidla pro velké online platformy kvůli AI manipulaci voleb.",
   "fact": "Komise 10. listopadu otevřela konzultaci k návrhu aktualizovaných volebních pokynů podle DSA. Návrh počítá mimo jiné s označováním deepfake obsahu, prověřováním doporučovacích algoritmů před volbami a rychlejším řešením napodobování kandidátů; připomínky přijímá do 23. listopadu.",
   "impact": "Pokud budou pokyny přijaty a účinně uplatňovány, mohly by v příštích třech letech ztížit manipulaci volební debaty i v ČR. Zatím jde o návrh v konzultaci, nikoli o přijaté opatření; jeho skutečný účinek není jistý.",
   "source_url": "https://digital-strategy.ec.europa.eu/en/consultations/targeted-consultation-draft-revised-election-guidelines-under-digital-services-act-dsa"
  }
 ],
