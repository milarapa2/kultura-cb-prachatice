 "news": [
  {
   "headline": "OpenAI oznámila, že její modely pomohly navrhnout účinnější obvody pro čipy AMD.",
   "fact": "OpenAI 18. listopadu uvedla, že její modely při spolupráci s AMD dosáhly až 14% zlepšení vybraných parametrů návrhu grafického čipu oproti již optimalizovanému základu; část úprav AMD zahrnula do návrhu odeslaného do výroby. Podle OpenAI její modely pomohly také snížit plochu některých obvodů vlastního čipu Jalapeño a tyto úpravy byly ověřeny na vyrobeném čipu.",
   "impact": "Pokud se tento způsob návrhu osvědčí i v dalších čipech, mohl by v příštích třech letech zrychlit vývoj výpočetního hardwaru pro AI a nepřímo ovlivnit dostupnost či cenu AI služeb používaných i v Česku. Uvedené výsledky pocházejí od OpenAI a samy o sobě neprokazují levnější služby ani podobné přínosy v celých budoucích čipech.",
   "source_url": "https://openai.com/index/advancing-chip-design-with-our-models/"
