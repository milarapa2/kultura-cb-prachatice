 "limitations": [
  "Prachatice: měsíční zpravodaj je přepis; změny programu nemusí být zachyceny. U vícedenních výstav ověřte otevírací dobu, rozsah neznamená otevřeno každý den.",
  "Prachatice: Galerie Dolní brána, Prachatické muzeum a Muzeum české loutky a cirkusu mají v pondělí zavřeno; jejich výstavy jsou vyřazeny. U Seniorpointu, Galerie Sklo a Galerie Neumannka nebylo potvrzeno pondělní otevření.",
  "Pokrytí Českých Budějovic není úplné: InBudějovice neposkytlo ověřitelné datované položky; týdenní ICM, Budějcké akce a Divadlo u Kapličky neměly použitelný aktuální program. Veřejné iCal kalendáře Horké vany pro dnešek nevrátily ověřenou akci.",
  "Víkend: dnes je pondělí; samostatné víkendové položky se zpracovávají pouze ve středu až pátek."
 ],
 "news": [
  {
   "headline": "Výrobce modelu Kimi před plánovaným zveřejněním jeho vah omezil schopnost pomáhat s kyberútoky.",
   "fact": "Čínská společnost Moonshot podle zprávy Reuters představila model Kimi K3.1 Pro a uvedla, že z jeho tréninku odstranila část kybernetických dat. Váhy modelu plánuje zveřejnit 4. listopadu; oslabení útočných schopností vychází pouze z jejího interního testu, který zatím nebyl nezávisle ověřen.",
   "impact": "Jde o konkrétní pokus snížit riziko zneužití otevřeného AI modelu při útocích na software, což může být v příštích třech letech důležité i pro digitální služby v Česku. Zda opatření skutečně obstojí po zveřejnění vah, zatím není jasné.",
   "source_url": "https://indianexpress.com/article/technology/artificial-intelligence/moonshot-curbs-hacking-ability-in-new-kimi-model-as-fears-grow-over-ai-powered-cyberattacks-10935831/"
