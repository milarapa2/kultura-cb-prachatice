 "news": [
  {
   "headline": "Nezávislá analýza zjistila u Anthropicu přibližně dvojnásobné tempo zlepšování modelů v měřených úlohách.",
   "fact": "Výzkumná organizace METR 5. listopadu zveřejnila analýzu interních dat Anthropicu: skóre jeho modelů ve sledovaném indexu od října 2025 rostlo zhruba 1,9krát rychleji než dříve. METR soudí, že významnou část zrychlení dnes způsobuje využití AI ve výzkumu, ale upozorňuje na značnou nejistotu a na začernění části důkazů firmou.",
   "impact": "Pokud se zrychlení potvrdí i mimo měřené úlohy, mohlo by během tří let ovlivnit rychlost nasazování AI do práce i tempo vývoje dalších modelů. Z jedné firmy a jejího interního ukazatele však nelze spolehlivě předpovědět obecný pokrok ani konkrétní dopady na zaměstnanost.",
   "source_url": "https://metr.org/blog/2026-11-05-anthropic-ai-rd-acceleration-assessment/"
  }
 ],
