 "news": [
  {
   "headline": "Anthropic zveřejnil burzovní prospekt a odkryl ekonomiku svého podnikání s AI.",
   "fact": "Anthropic 26. října podal u americké SEC registrační dokument pro zamýšlený vstup na burzu. V prospektu uvádí za první pololetí 2026 tržby 16,3 miliardy dolarů a provozní ztrátu 693 milionů dolarů; nabídka akcií zatím není účinná.",
   "impact": "Zveřejněné výsledky umožňují lépe posuzovat, zda se prudký růst využívání AI proměňuje v udržitelné podnikání, a mohou ovlivnit financování dalšího vývoje nástrojů používaných i v Česku. Budoucí ziskovost ani dopad na uživatele z těchto šesti měsíců nelze předpovědět.",
   "source_url": "https://www.sec.gov/Archives/edgar/data/2130357/000162828026067168/anthropicpbc-sx1.htm"
  }
 ],
